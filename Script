-- 플레이어의 몸 파츠가 완전히 생성될 때까지 안전하게 대기 후 착용하는 함수
local function applyAllDefaultIDs(character)
    if not character then return end
    
    local timeout = 0
    while not character:FindFirstChild("Head") or not character:FindFirstChildOfClass("Humanoid") do
        task.wait(0.2)
        timeout = timeout + 0.2
        if timeout > 5 then break end
    end
    
    task.wait(0.3)
    
    if DefaultIDs.shirt ~= "" then local id = tonumber(DefaultIDs.shirt) if id then applyClothing(id, "Shirt", character) end end
    if DefaultIDs.pants ~= "" then local id = tonumber(DefaultIDs.pants) if id then applyClothing(id, "Pants", character) end end
    if DefaultIDs.hair ~= "" then local id = tonumber(DefaultIDs.hair) if id then applyAccessory(id, "Hair", character) end end
    if DefaultIDs.hat ~= "" then local id = tonumber(DefaultIDs.hat) if id then applyAccessory(id, "Hat", character) end end
    if DefaultIDs.face ~= "" then local id = tonumber(DefaultIDs.face) if id then applyAccessory(id, "Face", character) end end
    if DefaultIDs.neck ~= "" then local id = tonumber(DefaultIDs.neck) if id then applyAccessory(id, "Neck", character) end end
    if DefaultIDs.shoulder ~= "" then local id = tonumber(DefaultIDs.shoulder) if id then applyAccessory(id, "Shoulder", character) end end
    if DefaultIDs.front ~= "" then local id = tonumber(DefaultIDs.front) if id then applyAccessory(id, "Front", character) end end
    if DefaultIDs.back ~= "" then local id = tonumber(DefaultIDs.back) if id then applyAccessory(id, "Back", character) end end
    if DefaultIDs.waist ~= "" then local id = tonumber(DefaultIDs.waist) if id then applyAccessory(id, "Waist", character) end end
end

