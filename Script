-- 장신구 크기 확대 함수
local function scaleAccessory(handle, accessoryType)
    local scaleFactor = 1.3
    if accessoryType == "Waist" or accessoryType == "Neck" then
        handle.Size = handle.Size * scaleFactor
        for _, child in ipairs(handle:GetChildren()) do
            if child:IsA("SpecialMesh") or child:IsA("BlockMesh") or child:IsA("CylinderMesh") then
                child.Scale = child.Scale * scaleFactor
            end
            if child:IsA("Attachment") then
                child.Position = child.Position * scaleFactor
            end
        end
    end
end

-- 액세서리 부착 함수
local function applyAccessory(id, removeFilter, targetCharacter)
    local character = targetCharacter or lp.Character
    if not character then return end
    local head = character:FindFirstChild("Head")
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not head or not humanoid then return end

    task.spawn(function()
        for _, v in ipairs(character:GetChildren()) do
            if v:IsA("Accessory") or v:IsA("Hat") then
                local handle = v:FindFirstChild("Handle")
                if handle then
                    local isMatch = false
                    if removeFilter == "Hair" then
                        if handle:FindFirstChild("HairAttachment") or v.Name:lower():find("hair") then isMatch = true end
                    elseif removeFilter == "Hat" then
                        if handle:FindFirstChild("HatAttachment") or v.Name:lower():find("hat") then isMatch = true end
                    elseif removeFilter == "Face" then
                        if handle:FindFirstChild("FaceFrontAttachment") or handle:FindFirstChild("FaceCenterAttachment") or v.Name:lower():find("face") then isMatch = true end
                    elseif removeFilter == "Neck" then
                        if handle:FindFirstChild("NeckAttachment") or v.Name:lower():find("neck") then isMatch = true end
                    elseif removeFilter == "Shoulder" then
                        if handle:FindFirstChild("ShoulderAttachment") or v.Name:lower():find("shoulder") then isMatch = true end
                    elseif removeFilter == "Front" then
                        if handle:FindFirstChild("FrontAttachment") or v.Name:lower():find("front") then isMatch = true end
                    elseif removeFilter == "Back" then
                        if handle:FindFirstChild("BackAttachment") or v.Name:lower():find("back") then isMatch = true end
                    elseif removeFilter == "Waist" then
                        if handle:FindFirstChild("WaistAttachment") or v.Name:lower():find("waist") then isMatch = true end
                    end
                    if isMatch then v:Destroy() end
                end
            end
        end

        local success, assets = pcall(function() return game:GetObjects("rbxassetid://" .. id) end)
        if success and assets then
            for _, obj in pairs(assets) do
                local toApply = {}
                if obj:IsA("Accessory") or obj:IsA("Hat") then table.insert(toApply, obj)
                else
                    for _, child in pairs(obj:GetDescendants()) do
                        if child:IsA("Accessory") or child:IsA("Hat") then table.insert(toApply, child) end
                    end
                end

                for _, acc in pairs(toApply) do
                    acc.Parent = character
                    local handle = acc:FindFirstChild("Handle")
                    if handle then
                        handle.CanCollide = false
                        scaleAccessory(handle, removeFilter)
                        
                        for _, w in pairs(handle:GetChildren()) do if w:IsA("Weld") or w:IsA("ManualWeld") then w:Destroy() end end
                        
                        local weld = Instance.new("Weld", handle)
                        weld.Part0 = handle
                        
                        local targetPart = head
                        if removeFilter == "Neck" then
                            targetPart = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso") or head
                        elseif removeFilter == "Shoulder" then
                            targetPart = character:FindFirstChild("RightUpperArm") or character:FindFirstChild("LeftUpperArm") or head
                        elseif removeFilter == "Front" or removeFilter == "Back" then
                            targetPart = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso") or head
                        elseif removeFilter == "Waist" then
                            targetPart = character:FindFirstChild("LowerTorso") or character:FindFirstChild("Torso") or head
                        end
                        weld.Part1 = targetPart
                        
                        local attachment = handle:FindFirstChildOfClass("Attachment")
                        local targetAttachment = attachment and targetPart:FindFirstChild(attachment.Name)
                        
                        if attachment and targetAttachment then
                            weld.C0 = attachment.CFrame
                            weld.C1 = targetAttachment.CFrame
                        else
                            weld.C0 = CFrame.new(0, -0.5, 0)
                            weld.C1 = CFrame.new(0, 0.5, 0)
                        end
                    end
                end
                if not obj:IsA("Accessory") and not obj:IsA("Hat") then obj:Destroy() end
            end
        end
    end)
end

-- 옷 적용 함수
local function applyClothing(id, type, targetCharacter)
    local character = targetCharacter or lp.Character
    if not character then return end
    local clothing = character:FindFirstChildOfClass(type) or Instance.new(type, character)
    task.spawn(function()
        local success, objs = pcall(function() return game:GetObjects("rbxassetid://" .. id) end)
        if success and objs and #objs > 0 then
            for _, v in pairs(objs) do 
                if v:IsA(type) then 
                    if type == "Shirt" then clothing.ShirtTemplate = v.ShirtTemplate 
                    else clothing.PantsTemplate = v.PantsTemplate end
                end 
                v:Destroy() 
            end
        else 
            if type == "Shirt" then clothing.ShirtTemplate = "rbxassetid://" .. id 
            else clothing.PantsTemplate = "rbxassetid://" .. id end
        end
    end)
end

