-- Headless 기능
local headlessEnabled = false
local originalHeadTransparency = 0
local originalHeadCanCollide = true

local function setHeadlessState(enabled)
    local character = lp.Character
    if character then
        local head = character:FindFirstChild("Head")
        if head then
            if enabled then
                originalHeadTransparency = head.Transparency
                originalHeadCanCollide = head.CanCollide
                head.Transparency = 1
                head.CanCollide = false
            else
                head.Transparency = originalHeadTransparency
                head.CanCollide = originalHeadCanCollide
            end
        end
    end
end

-- hairless 기능
local hairlessEnabled = false
local hairConnections = {}

local function applyHairlessToAccessory(handle, enabled)
    if handle then
        handle.LocalTransparencyModifier = enabled and 1 or 0
    end
end

local function setHairlessState(enabled)
    hairlessEnabled = enabled
    local character = lp.Character
    if not character then return end
    
    for _, conn in pairs(hairConnections) do
        conn:Disconnect()
    end
    hairConnections = {}
    
    for _, v in ipairs(character:GetChildren()) do
        if v:IsA("Accessory") then
            local handle = v:FindFirstChild("Handle")
            if handle and (handle:FindFirstChild("HairAttachment") or v.Name:lower():find("hair")) then
                applyHairlessToAccessory(handle, enabled)
            end
        end
    end
    
    if enabled then
        table.insert(hairConnections, character.ChildAdded:Connect(function(v)
            if v:IsA("Accessory") then
                task.wait(0.1)
                local handle = v:FindFirstChild("Handle")
                if handle and (handle:FindFirstChild("HairAttachment") or v.Name:lower():find("hair")) then
                    applyHairlessToAccessory(handle, true)
                end
            end
        end))
    end
end

